{
  "name": "excalibur-core",
  "private": true,
  "version": "1.2.0",
  "description": "Excalibur Core — open-source, local-first developer toolkit for AI-assisted and agentic software development",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .husky || true",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:real": "node scripts/verify-real.mjs",
    "verify:plan-shaping": "node scripts/verify-plan-shaping.mjs",
    "verify:scope-routing": "node scripts/verify-scope-routing.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
