{
  "name": "@excalibur/agent-runtime",
  "version": "1.2.0",
  "private": true,
  "description": "Agent adapter interfaces, native tools, permission engine and event emission for Excalibur",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "dependencies": {
    "@excalibur/model-gateway": "workspace:*",
    "@excalibur/shared": "workspace:*",
    "defuddle": "^0.19.3",
    "linkedom": "^0.18.13",
    "minimatch": "^10.2.6",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "typescript-language-server": "^5.3.0",
    "vitest": "^3.0.5"
  }
}
